[Unit]
Description=fakturobot: bot Telegram do faktur
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=fakturobot
Group=fakturobot
WorkingDirectory=/opt/fakturobot/app
# .env czyta systemd (root), więc plik może mieć root:root 600, a bot nie ma do niego dostępu
EnvironmentFile=/etc/fakturobot/.env
Environment=FAKTUROBOT_CONFIG=/etc/fakturobot/config.yaml
Environment=FAKTUROBOT_DATA_DIR=/var/lib/fakturobot
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/fakturobot/venv/bin/python -m fakturobot
Restart=on-failure
RestartSec=10
# 2 = błąd konfiguracji: nie restartuj w kółko, popraw plik i uruchom ponownie
RestartPreventExitStatus=2

# Dane: tylko /var/lib/fakturobot (baza SQLite), tworzone przez systemd z prawami 0700
StateDirectory=fakturobot
StateDirectoryMode=0700
UMask=0077

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/fakturobot
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
