# Sekrety fakturobota. Prawdziwy plik: /etc/fakturobot/.env (root:root, chmod 600).
# Wczytuje go systemd (EnvironmentFile), więc sam bot nie ma prawa go czytać.

# true = faktury testowe (osobna baza, PDF z napisem DRY_RUN) i żadnych maili
DRY_RUN=true

# Telegram: token od @BotFather i Twój chat_id (bot odpowiada tylko na ten czat)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail API (zakres tylko gmail.send). Wartości GOOGLE_* wypisze: python -m fakturobot.gmail_auth client_secret.json
GMAIL_SENDER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Adres księgowej i opcjonalnie kopia (DW), kilka adresów oddziel przecinkami
ACCOUNTANT_EMAIL=
ACCOUNTANT_CC=
